REACT_APP_ADMIN_PASSWORD=change-this-password
REACT_APP_CONTENT_API_URL=http://localhost:4000

CONTENT_ADMIN_PASSWORD=change-this-password
CONTENT_PORT=4000
CONTENT_ALLOWED_ORIGIN=http://localhost:3000
CONTENT_FILE=./data/site-content.json

# --- Forms API ---
# Local dev (frontend on :3000, standalone API via `npm run forms:server` on :4002):
REACT_APP_API_URL=http://localhost:4002
FORMS_PORT=4002
FORMS_ALLOWED_ORIGIN=http://localhost:3000

# Production build served by `npm run serve` (server/app.cjs): site and API
# share the same origin, so this must be an EMPTY string, not unset/deleted -
# REACT_APP_API_URL=
# PORT is normally set by the host (Heroku, ...) automatically; only set it
# yourself if you need a fixed port.
# PORT=3000

# Where submitted form data is emailed to.
MAIL_TO=ivan.tym4ak@gmail.com
MAIL_FROM=no-reply@topdental.com.ua

# SMTP account used to actually send the email. Without SMTP_HOST, the
# server just logs emails to the console instead of sending them - useful
# for local testing, but nothing will ever land in the MAIL_TO inbox.
#
# Resend (recommended - free tier, https://resend.com -> API Keys):
#   SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_SECURE=true,
#   SMTP_USER=resend, SMTP_PASS=<your Resend API key>
#   Until your domain is verified in Resend, MAIL_FROM must be onboarding@resend.dev
#
# Brevo (https://brevo.com -> Settings -> SMTP & API -> SMTP):
#   SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_SECURE=false,
#   SMTP_USER=<your Brevo account email>, SMTP_PASS=<SMTP key, not your password>
#
# Gmail (needs 2FA + an App Password, not your normal password):
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
#   SMTP_USER=your-account@gmail.com, SMTP_PASS=<Gmail App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
